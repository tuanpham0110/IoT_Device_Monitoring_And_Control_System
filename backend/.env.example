# ===== HTTP Server =====
PORT=5000
# Danh sách origin của Frontend được phép gọi API (phân tách bằng dấu phẩy), "*" = cho phép tất cả
CORS_ORIGIN=http://localhost:5173

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
# Database tự được tạo khi backend khởi động nếu chưa có
DB_NAME=iot_dashboard

# ===== MQTT Broker =====
MQTT_HOST=127.0.0.1
MQTT_PORT=1889
MQTT_USERNAME=phamductuan
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=iot-backend

MQTT_TOPIC_SENSOR=data/sensor
MQTT_TOPIC_CONTROL=device/control
MQTT_TOPIC_RESPONSE=device/response

# Thời gian chờ ESP32 phản hồi lệnh điều khiển (ms)
CONTROL_TIMEOUT_MS=3000
# Không nhận được dữ liệu từ ESP32 sau khoảng này (ms) thì đánh dấu thiết bị offline
OFFLINE_AFTER_MS=15000
